<Window x:Class="Sc2Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Text[星际争霸 II · 双服切换]}" Width="740" Height="678" MinWidth="520" MinHeight="560" WindowStartupLocation="CenterScreen"
 Background="#F8F9FB" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" Icon="switcher.ico">
 <Grid x:Name="Root" Background="#F8F9FB">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="{StaticResource SwitcherMark}" Width="30" Height="30" Margin="0,0,12,0" Stretch="Uniform"/>
    <TextBlock Grid.Column="1" Text="{Binding Text[星际争霸 II]}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Content="{Binding Text[安装详情]}" Click="Details_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0" IsEnabled="{Binding IsIdle}"/>
    <Button Grid.Column="3" Content="{Binding Text[设置]}" Click="Settings_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0" IsEnabled="{Binding CanInspect}"/>
    <Button Grid.Column="4" Content="{Binding Text[帮助]}" Click="Help_Click" Style="{StaticResource QuietButton}" IsEnabled="{Binding IsIdle}"/>
   </Grid>
  </Border>
  <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <Grid x:Name="Workspace" Margin="32,25,32,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,27">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Text[战网当前配置]}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,5"/><TextBlock Text="{Binding CurrentRegion}" FontSize="18" FontWeight="SemiBold" ToolTip="{Binding Text[读取自战网本地配置，不包含账号登录状态。]}"/></StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Text[切换至]}" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,17"/>
    <Grid Grid.Row="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <RadioButton x:Name="ChinaCard" GroupName="Server" Style="{StaticResource ServerRow}" IsChecked="{Binding IsChina}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding Text[切换目标：国服，简体中文]}" Margin="0,0,0,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Text[国服]}" FontSize="19" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Text[简体中文]}" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
     </RadioButton>
     <RadioButton x:Name="GlobalCard" Grid.Row="1" GroupName="Server" Style="{StaticResource ServerRow}" IsChecked="{Binding IsGlobal}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding Text[切换目标：外服，英文]}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Text[外服]}" FontSize="19" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="English" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
     </RadioButton>
    </Grid>
    <Grid x:Name="RegionRow" Grid.Row="3" Margin="0,17,0,0" MinHeight="40">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Text[外服登录区域]}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanEditRegion}">
      <RadioButton Content="{Binding Text[欧洲]}" GroupName="Region" Style="{StaticResource RegionChoice}" IsChecked="{Binding Europe}" AutomationProperties.Name="{Binding Text[欧洲登录区域]}"/>
      <RadioButton Content="{Binding Text[美洲]}" GroupName="Region" Style="{StaticResource RegionChoice}" IsChecked="{Binding Americas}" AutomationProperties.Name="{Binding Text[美洲登录区域]}" Margin="5,0"/>
      <RadioButton Content="{Binding Text[亚洲]}" GroupName="Region" Style="{StaticResource RegionChoice}" IsChecked="{Binding Asia}" AutomationProperties.Name="{Binding Text[亚洲登录区域]}"/>
     </StackPanel>
    </Grid>
    <TextBlock Grid.Row="4" Text="{Binding Text[切换时按所选版本设置游戏语言。]}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,15,0,0"/>
   </Grid>
  </ScrollViewer>
  <Border x:Name="ActionDock" Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
   <Grid>
    <UniformGrid Rows="1" VerticalAlignment="Top" Height="3" Visibility="{Binding ProgressVisibility}"><Border Background="{Binding StepOneColor}" Margin="0,0,3,0"/><Border Background="{Binding StepTwoColor}" Margin="0,0,3,0"/><Border Background="{Binding StepThreeColor}"/></UniformGrid>
    <Grid x:Name="DockContent" Margin="32,19,32,22">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid MinHeight="54" Margin="0,0,0,17">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Ellipse Fill="{Binding StatusColor}" Width="7" Height="7" VerticalAlignment="Top" Margin="0,7,11,0"/>
      <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="14" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="19" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding StepLabel}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{Binding ProgressVisibility}"/>
      <Button Grid.Column="2" Content="{Binding Text[查看原因]}" Click="StatusDetails_Click" Style="{StaticResource QuietButton}" Visibility="{Binding ErrorVisibility}" VerticalAlignment="Top" Padding="8,0" MinHeight="25"/>
     </Grid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="CheckButton" Content="{Binding Text[重新检查]}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-8,0,0,0" Click="Check_Click" IsEnabled="{Binding CanInspect}"/>
      <Grid Grid.Column="1">
       <Button x:Name="SwitchButton" Style="{StaticResource PrimaryButton}" MinWidth="204" Click="Switch_Click" IsEnabled="{Binding CanSwitch}" Visibility="{Binding SwitchVisibility}" AutomationProperties.Name="{Binding ActionLabel}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ActionLabel}" FontSize="14" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M0,5 L14,5 M9,0 L14,5 L9,10" Stroke="White" StrokeThickness="1.5" Width="15" Height="12" Margin="24,0,0,0" VerticalAlignment="Center"/></Grid>
       </Button>
       <Border x:Name="BusyIndicator" MinWidth="204" MinHeight="48" Padding="18,10" CornerRadius="6" Background="#EFF3FF" Visibility="{Binding BusyVisibility}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="28" Height="3" Margin="0,0,12,0"/><TextBlock Text="{Binding BusyLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></StackPanel>
       </Border>
      </Grid>
     </Grid>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
