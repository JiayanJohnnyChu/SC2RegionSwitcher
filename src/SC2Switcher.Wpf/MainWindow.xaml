<Window x:Class="Sc2Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Text[星际争霸 II · 双服切换]}" Width="760" Height="620" MinWidth="520" MinHeight="560" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="{Binding UiFontFamily}" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" Icon="switcher.ico">
 <Grid x:Name="Root" Background="{StaticResource Paper}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="Header" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="32,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource SwitcherMark}" Width="26" Height="26" Margin="0,0,11,0"/><TextBlock Text="SC2" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="BrandDescriptor" Text="{Binding Text[区域切换器]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,12,0" VerticalAlignment="Center"/></StackPanel>
    <Button Grid.Column="1" Content="{Binding Text[安装详情]}" Click="Details_Click" Style="{StaticResource QuietButton}" IsEnabled="{Binding IsIdle}"/>
    <Button Grid.Column="2" Content="{Binding Text[设置]}" Click="Settings_Click" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanInspect}" Margin="5,0"/>
    <Button Grid.Column="3" Content="{Binding Text[帮助]}" Click="Help_Click" Style="{StaticResource QuietButton}" IsEnabled="{Binding IsIdle}"/>
   </Grid>
  </Border>
  <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <Grid x:Name="Workspace" Margin="32,26,32,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Intro" Margin="0,0,0,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="HeroTitle" Text="{Binding Text[切换区域]}" Style="{StaticResource PageTitle}"/></StackPanel>
     <Border x:Name="CurrentMarker" Grid.Column="1" Style="{StaticResource CurrentRegionRule}" BorderThickness="2,0,0,0" Padding="18,2,0,2" VerticalAlignment="Center" Width="170">
      <StackPanel><TextBlock Text="{Binding Text[当前配置]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,5"/><TextBlock Text="{Binding CurrentRegion}" FontSize="15" FontWeight="SemiBold" ToolTip="{Binding Text[读取自战网本地配置，不包含账号登录状态。]}"/><TextBlock Text="{Binding Text[战网本地配置]}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
     </Border>
    </Grid>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <RadioButton x:Name="ChinaCard" Tag="CN" Grid.Column="0" GroupName="Server" Style="{StaticResource ServerRow}" IsChecked="{Binding IsChina}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding Text[切换目标：国服，简体中文]}">
      <StackPanel><TextBlock Text="CN" Style="{StaticResource DestinationMeta}" Margin="0,0,0,10"/><TextBlock Text="{Binding Text[国服]}" Style="{StaticResource DestinationTitle}"/><TextBlock Text="{Binding Text[简体中文]}" Style="{StaticResource DestinationDetail}" Margin="0,5,0,0"/></StackPanel>
     </RadioButton>
     <RadioButton x:Name="GlobalCard" Tag="Global" Grid.Column="2" GroupName="Server" Style="{StaticResource ServerRow}" IsChecked="{Binding IsGlobal}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding Text[切换目标：外服，英文]}">
      <StackPanel><TextBlock Text="{Binding Region}" ToolTip="{Binding Text[外服登录区域]}" Style="{StaticResource DestinationMeta}" Margin="0,0,0,10"/><TextBlock Text="{Binding Text[外服]}" Style="{StaticResource DestinationTitle}"/><TextBlock Text="{Binding Text[英文]}" Style="{StaticResource DestinationDetail}" Margin="0,5,0,0"/></StackPanel>
     </RadioButton>
    </Grid>
    <Grid x:Name="RegionRow" Grid.Row="2" Margin="0,22,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Text[外服登录区域]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
     <UniformGrid Grid.Row="1" Rows="1" IsEnabled="{Binding CanEditRegion}">
      <RadioButton Content="{Binding Text[欧洲]}" GroupName="Region" Style="{StaticResource RegionChoice}" IsChecked="{Binding Europe}" AutomationProperties.Name="{Binding Text[欧洲登录区域]}"/>
      <RadioButton Content="{Binding Text[美洲]}" GroupName="Region" Style="{StaticResource RegionChoice}" IsChecked="{Binding Americas}" AutomationProperties.Name="{Binding Text[美洲登录区域]}"/>
      <RadioButton Content="{Binding Text[亚洲]}" GroupName="Region" Style="{StaticResource RegionChoice}" IsChecked="{Binding Asia}" AutomationProperties.Name="{Binding Text[亚洲登录区域]}"/>
     </UniformGrid>
    </Grid>
   </Grid>
  </ScrollViewer>
  <Border x:Name="ActionDock" Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
   <Grid>
    <UniformGrid Rows="1" VerticalAlignment="Top" Height="2" Visibility="{Binding ProgressVisibility}"><Border Background="{Binding StepOneColor}" Margin="0,0,3,0"/><Border Background="{Binding StepTwoColor}" Margin="0,0,3,0"/><Border Background="{Binding StepThreeColor}"/></UniformGrid>
    <Grid x:Name="DockContent" Margin="32,19,32,22">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusSymbol}" Foreground="{Binding StatusColor}" FontSize="13" FontWeight="SemiBold" Width="11" VerticalAlignment="Top" Margin="0,0,8,0" AutomationProperties.Name="{Binding StatusTitle}"/>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="13" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="18" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}" Margin="0,3,0,0"/></StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding StepLabel}" Foreground="{StaticResource Muted}" FontSize="12" Visibility="{Binding ProgressVisibility}" Margin="0,1,0,0"/>
      <Button Grid.Column="2" Content="{Binding Text[查看原因]}" Click="StatusDetails_Click" Style="{StaticResource QuietButton}" Visibility="{Binding ErrorVisibility}" VerticalAlignment="Top" Padding="8,0" MinHeight="25"/>
     </Grid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="CheckButton" Content="{Binding Text[重新检查]}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-10,0,0,0" Click="Check_Click" IsEnabled="{Binding CanInspect}"/>
      <Grid Grid.Column="1">
       <Button x:Name="SwitchButton" Style="{StaticResource PrimaryButton}" MinWidth="196" Click="Switch_Click" IsEnabled="{Binding CanSwitch}" Visibility="{Binding SwitchVisibility}" AutomationProperties.Name="{Binding ActionLabel}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ActionLabel}" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M0,5 L14,5 M9,0 L14,5 L9,10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="15" Height="12" Margin="28,0,0,0" VerticalAlignment="Center"/></Grid>
       </Button>
       <Border x:Name="BusyIndicator" MinWidth="196" MinHeight="46" Padding="18,10" CornerRadius="2" Background="{StaticResource Soft}" Visibility="{Binding BusyVisibility}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Foreground="{StaticResource Muted}" Width="24" Height="2" Margin="0,0,12,0"/><TextBlock Text="{Binding BusyLabel}" FontSize="13" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/></StackPanel>
       </Border>
      </Grid>
     </Grid>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
