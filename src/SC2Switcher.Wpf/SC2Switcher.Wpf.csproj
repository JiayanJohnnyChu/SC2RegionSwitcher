<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SC2Switcher.Wpf</AssemblyName>
    <RootNamespace>Sc2Wpf</RootNamespace>
    <Version>3.4.1</Version>
    <ApplicationIcon>..\..\assets\icon\switcher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\icon\switcher.ico" Link="switcher.ico" />
    <EmbeddedResource Include="Strings.zh-CN.json" LogicalName="Sc2Switch2.Strings.zh-CN.json" WithCulture="false" />
    <EmbeddedResource Include="Strings.en-US.json" LogicalName="Sc2Switch2.Strings.en-US.json" WithCulture="false" />
  </ItemGroup>
</Project>
