<UserControl x:Class="Sc2Wpf.SwissReferenceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel x:Name="ReadingArea" Margin="40,28">
   <TextBlock x:Name="Category" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" Margin="0,12"/><TextBlock x:Name="Introduction" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,28"/>
   <Border x:Name="ErrorPanel" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="Transparent" Margin="0,0,0,24"><Border x:Name="ErrorContentFrame" BorderBrush="{StaticResource Error}" BorderThickness="2,0,0,0" Margin="-1,0,0,0" Padding="24,20"><TextBox x:Name="ErrorContent" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" FontSize="14" TextBlock.LineHeight="23.8" TextBlock.LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/></Border></Border>
   <ItemsControl x:Name="Articles"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" FontSize="28" MinWidth="42" Margin="0,0,28,0" Visibility="{Binding NumberVisibility}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/><TextBlock Text="{Binding Body}" FontSize="14" LineHeight="24" Foreground="{StaticResource Muted}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
  <Border x:Name="ReferenceDock" Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="40,20" MinHeight="76"><Grid x:Name="FooterGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="SC2 / REGION SWITCHER" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><WrapPanel x:Name="ReferenceActions" Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="EditButton" Style="{StaticResource QuietButton}" Margin="20,0" Click="Edit_Click"/><Button x:Name="BackButton" Style="{StaticResource QuietButton}" Click="Back_Click"/></WrapPanel></Grid></Border>
 </Grid>
</UserControl>
