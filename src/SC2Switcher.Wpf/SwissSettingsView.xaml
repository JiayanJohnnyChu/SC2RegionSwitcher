<UserControl x:Class="Sc2Wpf.SwissSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sc2Switch2" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollChanged="FormScroll_ScrollChanged"><StackPanel x:Name="FormContent" Margin="40,28">
 <StackPanel x:Name="PageHeading" Margin="0,0,0,28"><TextBlock x:Name="SettingsCategory" Text="{Binding Text[web.configuration]}" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SettingsTitle" Text="{Binding Text[web.settingsTitle]}" Style="{StaticResource PageTitle}" Margin="0,12"/><TextBlock Text="{Binding Text[web.settingsIntro]}" Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel>
 <Border BorderBrush="{StaticResource Error}" BorderThickness="3,0,0,0" Padding="16,12" Margin="0,0,0,18" Visibility="{Binding NoticeVisibility}"><TextBlock Text="{Binding Notice}" FontSize="14"/></Border>
<Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0"><Grid x:Name="InstallationsSection" Margin="0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid x:Name="InstallationsSectionTitle"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="InstallationsNumber" Text="01" FontFamily="{x:Static local:UiTypography.Latin}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="InstallationsHeading" Text="{Binding Text[web.installations]}" FontSize="19" FontWeight="Medium"/><TextBlock Text="{Binding Text[web.installationsHint]}" FontSize="13" Foreground="{StaticResource Muted}" LineHeight="21" Margin="0,7,0,0"/></StackPanel></Grid>
 <StackPanel x:Name="InstallationsSectionFields" Grid.Column="2">
 <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Text[web.globalDisplay]}" FontSize="20" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding GlobalCheckLabel}" Foreground="{Binding GlobalCheckColor}" FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
 <TextBlock Text="{Binding Text[web.installationPath]}" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource PathContainer}" IsEnabled="{Binding CanEdit}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox x:Name="GlobalField" Text="{Binding GlobalDirectory,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathField}" AutomationProperties.Name="{Binding Text[外服游戏目录]}" LostKeyboardFocus="GlobalDirectory_LostKeyboardFocus"/><Button Grid.Column="1" Style="{StaticResource FolderButton}" Tag="GlobalDirectory" Click="BrowseFolder_Click" ToolTip="{Binding Text[选择目录]}" AutomationProperties.Name="{Binding Text[浏览外服游戏目录]}"/></Grid></Border>
 <WrapPanel Margin="0,10,0,0"><TextBlock Text="{Binding Text[web.version]}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,9,0"/><TextBlock Text="{Binding GlobalVersion}" FontSize="13"/></WrapPanel>
 <TextBlock Text="{Binding GlobalCheckNote}" Style="{StaticResource FieldNote}"/>
 <StackPanel x:Name="GameLanguageSection" Margin="0,17,0,0"><WrapPanel Margin="0,0,0,9"><TextBlock Text="{Binding Text[外服游戏语言（实验性）]}" FontSize="13" FontWeight="Medium" Margin="0,0,15,0"/><Button x:Name="DetectLanguagesButton" Content="{Binding Text[web.refreshLanguages]}" Style="{StaticResource QuietButton}" Padding="0" MinHeight="20" Click="DetectLanguages_Click" IsEnabled="{Binding CanDetectLanguage}"/></WrapPanel>
 <ComboBox x:Name="GameLanguagePicker" Style="{StaticResource LanguagePicker}" ItemsSource="{Binding AvailableLanguages}" SelectedValuePath="Code" SelectedValue="{Binding GlobalLanguage,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelectLanguage}" AutomationProperties.Name="{Binding Text[外服游戏语言（实验性）]}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
 <TextBlock Text="{Binding DetectionMessage}" Style="{StaticResource FieldNote}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding MixedLanguageSummary}" Style="{StaticResource FieldNote}"/>
 </StackPanel>
 <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,23,0,0" Padding="0,23,0,0"><StackPanel>
 <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Text[web.chinaDisplay]}" FontSize="20" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ChinaCheckLabel}" Foreground="{Binding ChinaCheckColor}" FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
 <TextBlock Text="{Binding Text[web.installationPath]}" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource PathContainer}" IsEnabled="{Binding CanEdit}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox x:Name="ChinaField" Text="{Binding ChinaDirectory,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathField}" AutomationProperties.Name="{Binding Text[国服游戏目录]}" /><Button Grid.Column="1" Style="{StaticResource FolderButton}" Tag="ChinaDirectory" Click="BrowseFolder_Click" ToolTip="{Binding Text[选择目录]}" AutomationProperties.Name="{Binding Text[浏览国服游戏目录]}"/></Grid></Border>
 <WrapPanel Margin="0,10,0,0"><StackPanel Orientation="Horizontal" Margin="0,0,24,0"><TextBlock Text="{Binding Text[web.version]}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,9,0"/><TextBlock Text="{Binding ChinaVersion}" FontSize="13"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text[web.gameLanguage]}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,9,0"/><TextBlock Text="{Binding Text[web.chinaLanguage]}" FontSize="13"/></StackPanel></WrapPanel>
 <TextBlock Text="{Binding ChinaCheckNote}" Style="{StaticResource FieldNote}"/>
 </StackPanel></Border></StackPanel></Grid></Border><Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0"><Grid x:Name="LauncherSection" Margin="0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid x:Name="LauncherSectionTitle"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" FontFamily="{x:Static local:UiTypography.Latin}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Text[web.launcher]}" FontSize="19" FontWeight="Medium"/><TextBlock Text="{Binding Text[web.launcherHint]}" FontSize="13" Foreground="{StaticResource Muted}" LineHeight="21" Margin="0,7,0,0"/></StackPanel></Grid>
 <StackPanel x:Name="LauncherSectionFields" Grid.Column="2"><TextBlock Text="{Binding Text[战网目录]}" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource PathContainer}" IsEnabled="{Binding CanEdit}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox x:Name="BattleField" Text="{Binding BattleNetDirectory,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathField}" AutomationProperties.Name="{Binding Text[战网目录]}" /><Button Grid.Column="1" Style="{StaticResource FolderButton}" Tag="BattleNetDirectory" Click="BrowseFolder_Click" ToolTip="{Binding Text[选择目录]}" AutomationProperties.Name="{Binding Text[浏览战网目录]}"/></Grid></Border><TextBlock Text="{Binding Text[web.launcherExecutable]}" Style="{StaticResource FieldNote}"/></StackPanel></Grid></Border><Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0"><Grid x:Name="InterfaceSection" Margin="0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid x:Name="InterfaceSectionTitle"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="03" FontFamily="{x:Static local:UiTypography.Latin}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Text[web.interface]}" FontSize="19" FontWeight="Medium"/><TextBlock Text="{Binding Text[web.interfaceHint]}" FontSize="13" Foreground="{StaticResource Muted}" LineHeight="21" Margin="0,7,0,0"/></StackPanel></Grid>
 <StackPanel x:Name="InterfaceSectionFields" Grid.Column="2"><TextBlock Text="{Binding Text[界面语言]}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LanguagePicker" Style="{StaticResource LanguagePicker}" ItemsSource="{Binding InterfaceLanguages}" ItemTemplate="{StaticResource InterfaceLanguageTemplate}" SelectedValuePath="Code" SelectedValue="{Binding UiLanguage,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Text[界面语言]}"/></StackPanel></Grid></Border>
 <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,22,0,5"><Expander x:Name="Advanced" Header="{Binding Text[web.advanced]}" IsEnabled="{Binding CanEdit}"><StackPanel Margin="0,18,0,0"><TextBlock Text="{Binding Text[共享游戏设置文件]}" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource PathContainer}" IsEnabled="{Binding CanEdit}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox x:Name="VariablesField" Text="{Binding VariablesFile,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathField}" AutomationProperties.Name="{Binding Text[共享游戏设置文件]}" /><Button Grid.Column="1" Style="{StaticResource FolderButton}" Tag="VariablesFile" Click="BrowseVariables_Click" ToolTip="{Binding Text[选择目录]}" AutomationProperties.Name="{Binding Text[浏览共享游戏设置文件]}"/></Grid></Border></StackPanel></Expander></Border>
 </StackPanel></ScrollViewer>
 <Border x:Name="SettingsDock" Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="40,20" MinHeight="96"><StackPanel>
  <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{Binding MessageColor}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding MessageVisibility}" Margin="0,0,0,8"/>
  <TextBlock Text="{Binding Text[web.unsaved]}" Visibility="{Binding DiscardVisibility}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
  <WrapPanel x:Name="DockActions" HorizontalAlignment="Right"><Button Content="{Binding Text[返回切换]}" Style="{StaticResource QuietButton}" Click="Back_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,20,8" VerticalAlignment="Center"/><Button Content="{Binding Text[放弃修改]}" Style="{StaticResource QuietButton}" Click="Discard_Click" IsEnabled="{Binding CanEdit}" Visibility="{Binding DiscardVisibility}" Margin="0,0,20,8" VerticalAlignment="Center"/><Button x:Name="SaveButton" Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="{Binding CanSave}" MinWidth="190" MaxWidth="320" Margin="0,0,0,8"/></WrapPanel>
 </StackPanel></Border>
 </Grid>
</UserControl>
