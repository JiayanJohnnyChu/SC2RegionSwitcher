<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wpf="clr-namespace:Sc2Wpf" xmlns:local="clr-namespace:Sc2Switch2" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Palette.xaml"/></ResourceDictionary.MergedDictionaries>
 <DataTemplate DataType="{x:Type sys:String}"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
 <DataTemplate x:Key="InterfaceLanguageTemplate"><TextBlock Text="{Binding Name}" FontFamily="{Binding Font}" TextWrapping="NoWrap" LineHeight="22" LineStackingStrategy="BlockLineHeight"/></DataTemplate>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{Binding DisplayFontFamily}"/><Setter Property="FontSize" Value="36"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="FieldNote" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="LineHeight" Value="21"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
 <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource Ink}" BorderThickness="3" Margin="-4"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Button"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="0,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextDecorations="Underline" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style>
 <Style x:Key="StatusActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
  <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="0,7"/><Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextDecorations="Underline" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"/></DataTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="StatusRepairButton" TargetType="Button" BasedOn="{StaticResource StatusActionButton}">
  <Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"/></DataTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{StaticResource Ink}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="56"/><Setter Property="Padding" Value="20,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions><TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,22,0"/><Path Grid.Column="1" Data="M4,12 L19,12 M12,5 L19,12 L12,19" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="23" Height="24" VerticalAlignment="Center"/></Grid></DataTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FolderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="44"/><Setter Property="MinHeight" Value="46"/><Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/><Setter Property="BorderThickness" Value="0,0,0,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="Transparent" BorderBrush="{StaticResource ControlLine}" BorderThickness="1,0,0,0"><Path Data="M3,19 L3,5 L9,5 L11,8 L21,8 L21,19 Z" Stroke="{StaticResource Ink}" StrokeThickness="1.7" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Paper}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="PathField" TargetType="TextBox">
  <!-- Fields use a 22-DIP line and 12-DIP insets inside the 1-DIP border (48 DIP total). TextBoxView contributes 2 DIP to horizontal padding. -->
  <Setter Property="FontFamily" Value="{x:Static local:UiTypography.Path}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="10,12"/><Setter Property="TextBlock.LineHeight" Value="22"/><Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/><Setter Property="MaxLength" Value="4096"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PathContainer" TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource Surface}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="LanguageOption" TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="{StaticResource Surface}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{StaticResource Soft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{StaticResource Paper}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="LanguagePicker" TargetType="ComboBox">
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="12,12,34,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ItemContainerStyle" Value="{StaticResource LanguageOption}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M1,1 L6,6 L11,1" Stroke="{StaticResource Ink}" StrokeThickness="1" Width="12" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </Grid></Border>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="HeaderLanguagePicker" TargetType="ComboBox" BasedOn="{StaticResource LanguagePicker}"><Setter Property="Width" Value="132"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,0,34,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></Style>
 <Style x:Key="NavigationTab" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="44"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" BorderBrush="Transparent" BorderThickness="0,0,0,3" Background="Transparent"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{StaticResource ScrollGrip}" Margin="3,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="Toggle" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" FocusVisualStyle="{StaticResource FocusRing}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="0,8"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="›" Width="18"/><ContentPresenter/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="InstallationChoice" TargetType="wpf:InstallationChoice">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="22,15"/><Setter Property="MinHeight" Value="144"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="wpf:InstallationChoice">
   <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
    <Grid><Grid Margin="{TemplateBinding Padding}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{TemplateBinding Number}" FontFamily="{x:Static local:UiTypography.Latin}" FontSize="12" VerticalAlignment="Center"/>
     <TextBlock x:Name="SelectedLabel" Grid.Column="1" Text="{Binding Text[web.selected]}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" Visibility="Hidden"/>
     <Grid Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center"><Ellipse Stroke="{StaticResource Ink}" StrokeThickness="1"/><Path x:Name="Tick" Data="M5,10 L8,13 L15,6" Stroke="{StaticResource Ink}" StrokeThickness="1.4" Visibility="Hidden"/></Grid>
     <TextBlock x:Name="Name" Grid.Row="1" Grid.ColumnSpan="3" Text="{TemplateBinding Label}" FontFamily="{Binding DestinationFontFamily}" FontSize="{TemplateBinding LabelSize}" FontWeight="{Binding DestinationWeight}" LineHeight="{Binding DestinationLineHeight}" Margin="0,6,0,9" TextWrapping="Wrap"/>
     <Grid x:Name="Bottom" Grid.Row="2" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid x:Name="AvailabilitySurface" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="AvailabilityMarker" Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top" BorderBrush="{StaticResource Ink}"><TextBlock x:Name="AvailableSymbol" Text="✓" FontFamily="{x:Static local:UiTypography.Latin}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/></Border>
       <TextBlock x:Name="AvailabilityLabel" Grid.Column="2" Text="{TemplateBinding Availability}" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
      </Grid>
      <TextBlock Grid.Column="1" Text="{TemplateBinding RegionCode}" FontFamily="{x:Static local:UiTypography.Latin}" FontSize="13" FontWeight="Bold" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top" Margin="16,0,0,0"/>
     </Grid>
    </Grid><Border x:Name="SelectedRule" Height="3" Background="{StaticResource Ink}" VerticalAlignment="Bottom" Visibility="Hidden"/></Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible"/><Setter TargetName="SelectedRule" Property="Visibility" Value="Visible"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Tile" Property="Background" Value="{StaticResource Surface}"/></MultiTrigger>
    <Trigger Property="IsAvailable" Value="False"><Setter TargetName="AvailableSymbol" Property="Text" Value="!"/><Setter TargetName="AvailableSymbol" Property="FontSize" Value="11"/><Setter TargetName="AvailabilityMarker" Property="BorderThickness" Value="1"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Tile" Property="Opacity" Value="0.7"/></Trigger>
    <Trigger Property="IsCompact" Value="True"><Setter TargetName="SelectedLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="Name" Property="Grid.Row" Value="0"/><Setter TargetName="Name" Property="Grid.Column" Value="1"/><Setter TargetName="Name" Property="Grid.ColumnSpan" Value="1"/><Setter TargetName="Name" Property="Margin" Value="12,0,12,0"/><Setter TargetName="Name" Property="VerticalAlignment" Value="Center"/><Setter TargetName="Bottom" Property="Grid.Row" Value="1"/><Setter TargetName="Bottom" Property="Grid.Column" Value="1"/><Setter TargetName="Bottom" Property="Grid.ColumnSpan" Value="2"/><Setter TargetName="Bottom" Property="Margin" Value="12,6,0,0"/><Setter TargetName="AvailabilityLabel" Property="FontSize" Value="12"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SwissRegion" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="7,7"/><Setter Property="MinHeight" Value="42"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ControlLine}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource Ink}"/><Setter Property="Foreground" Value="White"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.5"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SwissSection" TargetType="Grid"><Setter Property="Margin" Value="0,24,0,24"/></Style>
</ResourceDictionary>
