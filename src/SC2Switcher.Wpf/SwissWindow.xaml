<Window x:Class="Sc2Wpf.SwissWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sc2Switch2" xmlns:wpf="clr-namespace:Sc2Wpf"
 Title="SC2 / Region Switcher" Width="1000" Height="820" MinWidth="360" MinHeight="560" WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="{Binding UiFontFamily}" Language="{Binding TextLanguage}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" Icon="switcher.ico">
 <Grid x:Name="Shell" Background="{StaticResource Paper}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="Header" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Padding="40,6" MinHeight="60">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontFamily="{x:Static local:UiTypography.Latin}"><TextBlock x:Name="BrandSC2" Text="SC2" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="/" FontSize="23" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center"/><TextBlock x:Name="BrandDescriptor" Text="Region Switcher" FontSize="14" VerticalAlignment="Center"/></StackPanel>
    <ComboBox x:Name="HeaderLanguage" Grid.Column="1" Style="{StaticResource HeaderLanguagePicker}" ItemsSource="{Binding InterfaceLanguages}" ItemTemplate="{StaticResource InterfaceLanguageTemplate}" SelectedValuePath="Code" SelectedValue="{Binding UiLanguage,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanNavigate}" AutomationProperties.Name="{Binding Text[界面语言]}"/>
   </Grid>
  </Border>
  <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><UniformGrid x:Name="Navigation" Rows="1" MaxWidth="760" HorizontalAlignment="Stretch" Margin="40,0" IsEnabled="{Binding CanNavigate}">
   <RadioButton Content="{Binding Text[web.navHome]}" Tag="home" GroupName="Page" Style="{StaticResource NavigationTab}" IsChecked="{Binding HomeActive,Mode=OneWay}" Checked="Navigation_Checked" Click="Home_Click"/>
   <RadioButton Content="{Binding Text[设置]}" Tag="settings" GroupName="Page" Style="{StaticResource NavigationTab}" IsChecked="{Binding SettingsActive,Mode=OneWay}" Checked="Navigation_Checked" Click="Settings_Click"/>
   <RadioButton Content="{Binding Text[web.navHelp]}" Tag="guide" GroupName="Page" Style="{StaticResource NavigationTab}" IsChecked="{Binding GuideActive,Mode=OneWay}" Checked="Navigation_Checked" Click="Help_Click"/>
  </UniformGrid></Border>
  <Grid x:Name="PageHost" Grid.Row="2"><Grid x:Name="Root">
   <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid MinHeight="{Binding ViewportHeight,ElementName=MainScroll}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="Workspace" Margin="40,24,40,14">
      <Grid x:Name="Intro" Margin="0,0,0,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="0.58*" MinWidth="220"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="HeroTitle" Text="{Binding Text[web.taskTitle]}" Style="{StaticResource PageTitle}"/>
       <Border x:Name="CurrentMarker" Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="18,3,0,0"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Text[web.current]}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal" TextElement.FontFamily="{x:Static local:UiTypography.Latin}"><TextBlock x:Name="CurrentCode" Text="{Binding CurrentCode}" FontSize="21" FontWeight="Bold"/><TextBlock Text="/" FontSize="13" Margin="8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding CurrentLanguageCode}" FontSize="13" VerticalAlignment="Center"/></StackPanel>
        </Grid><TextBlock Text="{Binding Text[web.currentRecord]}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
       </StackPanel></Border>
      </Grid>
      <Border BorderBrush="{StaticResource Ink}" BorderThickness="1"><Grid x:Name="Destinations"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <wpf:InstallationChoice x:Name="GlobalCard" Style="{StaticResource InstallationChoice}" Number="01" Label="{Binding Text[web.globalDisplay]}" RegionCode="{Binding Region}" Availability="{Binding GlobalAvailability}" IsAvailable="{Binding GlobalAvailable}" GroupName="Server" IsChecked="{Binding IsGlobal}" IsEnabled="{Binding CanNavigate}" AutomationProperties.Name="{Binding GlobalTargetName}"/>
       <wpf:InstallationChoice x:Name="ChinaCard" Grid.Column="1" Style="{StaticResource InstallationChoice}" Number="02" Label="{Binding Text[web.chinaDisplay]}" RegionCode="CN" Availability="{Binding ChinaAvailability}" IsAvailable="{Binding ChinaAvailable}" BorderThickness="1,0,0,0" GroupName="Server" IsChecked="{Binding IsChina}" IsEnabled="{Binding CanNavigate}" AutomationProperties.Name="{Binding Text[切换目标：国服，简体中文]}"/>
      </Grid></Border>
      <Border x:Name="ConfigurationPanel" Padding="0,13,0,16" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"><StackPanel>
       <TextBlock x:Name="ConfigurationTitle" Text="{Binding TargetConfiguration}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
       <Grid x:Name="RegionRow"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Text[web.loginRegion]}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
         <Border BorderBrush="{StaticResource ControlLine}" BorderThickness="1" Visibility="{Binding GlobalVisibility}"><UniformGrid Rows="1" IsEnabled="{Binding CanEditRegion}">
          <RadioButton Style="{StaticResource SwissRegion}" BorderThickness="0" GroupName="Region" IsChecked="{Binding Europe}" AutomationProperties.Name="{Binding Text[web.europe]}"><StackPanel x:Name="RegionEUContent" Orientation="Horizontal"><TextBlock Text="EU" FontFamily="{x:Static local:UiTypography.Latin}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="{Binding Text[web.europe]}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource SwissRegion}" BorderThickness="1,0,0,0" GroupName="Region" IsChecked="{Binding Americas}" AutomationProperties.Name="{Binding Text[web.americas]}"><StackPanel x:Name="RegionUSContent" Orientation="Horizontal"><TextBlock Text="US" FontFamily="{x:Static local:UiTypography.Latin}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="{Binding Text[web.americas]}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource SwissRegion}" BorderThickness="1,0,0,0" GroupName="Region" IsChecked="{Binding Asia}" AutomationProperties.Name="{Binding Text[web.asia]}"><StackPanel x:Name="RegionKRContent" Orientation="Horizontal"><TextBlock Text="KR" FontFamily="{x:Static local:UiTypography.Latin}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="{Binding Text[web.asia]}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/></StackPanel></RadioButton>
         </UniformGrid></Border>
         <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MinHeight="42" Visibility="{Binding ChinaVisibility}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="CN" FontFamily="{x:Static local:UiTypography.Latin}" FontWeight="Bold"/><TextBlock Text="{Binding Text[web.chinaDisplay]}" Margin="12,0,0,0" FontSize="13"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="GameLanguagePanel" Grid.Column="2"><TextBlock Text="{Binding Text[web.gameLanguage]}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
         <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MinHeight="42"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GameLanguageValue" Text="{Binding TargetLanguage}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{Binding Text[web.change]}" Style="{StaticResource QuietButton}" Margin="14,0,0,0" Click="GameLanguage_Click" Visibility="{Binding GlobalVisibility}" IsEnabled="{Binding CanNavigate}"/></Grid></Border>
        </StackPanel>
       </Grid>
      </StackPanel></Border>
      <Border x:Name="Readiness" Margin="0,20,0,0" Background="Transparent">
       <Grid x:Name="StatusLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="StatusMessage" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border x:Name="StatusMarker" Width="18" Height="18" VerticalAlignment="Top" Margin="0,3,0,0" BorderBrush="{StaticResource Error}"><TextBlock x:Name="StatusSymbolText" Text="{Binding StatusSymbol}" FontFamily="{x:Static local:UiTypography.Latin}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/></Border>
         <StackPanel Grid.Column="2"><TextBlock x:Name="StatusHeading" Text="{Binding StatusTitle}" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" LineHeight="24" LineStackingStrategy="BlockLineHeight" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="StatusBody" Text="{Binding StatusDetail}" FontSize="13" Foreground="{StaticResource Muted}" LineHeight="21" LineStackingStrategy="BlockLineHeight" Margin="0,5,0,0" HorizontalAlignment="Left" Visibility="{Binding StatusDetailVisibility}"/>
          <TextBlock Text="{Binding StepLabel}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding BusyVisibility}"/>
         </StackPanel>
        </Grid>
        <Grid x:Name="RecoveryActions" Grid.Column="2" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="RepairPathButton" Content="{Binding Text[web.editPath]}" Style="{StaticResource StatusRepairButton}" Click="RepairPath_Click" Visibility="{Binding RepairVisibility}" IsEnabled="{Binding CanNavigate}"/>
         <Button x:Name="CheckButton" Grid.Column="2" Content="{Binding Text[web.recheck]}" Style="{StaticResource StatusActionButton}" Click="Check_Click" IsEnabled="{Binding CanInspect}"/>
         <Button x:Name="ErrorDetailsButton" Grid.Column="4" Content="{Binding Text[web.viewError]}" Style="{StaticResource StatusActionButton}" Click="StatusDetails_Click" Visibility="{Binding ErrorVisibility}"/>
        </Grid>
       </Grid>
      </Border>
     </StackPanel>
     <Border x:Name="ActionDock" Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="40,20" MinHeight="96"><Grid x:Name="DockContent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ChangeSummary" Text="{Binding ChangeSummary}" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="RestartNote" Text="{Binding Text[web.restartNote]}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/></StackPanel>
      <Button x:Name="SwitchButton" Grid.Column="2" Content="{Binding ApplyLabel}" Style="{StaticResource PrimaryButton}" Click="Switch_Click" IsEnabled="{Binding CanSwitch}" VerticalAlignment="Center" Visibility="{Binding SwitchVisibility}"/>
      <Border x:Name="BusyIndicator" Grid.Column="2" Background="{StaticResource Ink}" Padding="20,10" MinHeight="56" Visibility="{Binding BusyVisibility}"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding BusyLabel}" Foreground="White" FontWeight="SemiBold"/><ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0" Foreground="White"/></StackPanel></Border>
     </Grid></Border>
    </Grid>
   </ScrollViewer>
  </Grid></Grid>
  <Border x:Name="Colophon" Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Surface}" MinHeight="36" Padding="40,0"><TextBlock Text="{Binding EditionLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
 </Grid>
</Window>
